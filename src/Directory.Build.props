<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Everything under src/ ships as a NuGet package. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>Amin Chouaibi</Authors>
    <Copyright>Copyright (c) Amin Chouaibi</Copyright>
    <PackageProjectUrl>https://github.com/aminch18/wyrd</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aminch18/wyrd</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>event-driven;saga;process-manager;outbox;ddd;vertical-slice;deterministic;messaging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Analyzer assemblies are bundled in Wyrd; these three projects publish packages of their own. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wyrd' Or '$(MSBuildProjectName)' == 'Wyrd.Testing' Or '$(MSBuildProjectName)' == 'Wyrd.Tool'">
    <PackageValidationBaselineVersion>0.4.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <!-- Every package tracks its public API; the hosts first released in 0.5 have no baseline to validate against yet. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Wyrd' Or '$(MSBuildProjectName)' == 'Wyrd.Testing' Or '$(MSBuildProjectName)' == 'Wyrd.Tool' Or '$(MSBuildProjectName)' == 'Wyrd.EntityFrameworkCore' Or '$(MSBuildProjectName)' == 'Wyrd.RabbitMq'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- Q4.2: no sync-over-async (VSTHRD002 and friends); see src/.editorconfig for the rules in force. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
