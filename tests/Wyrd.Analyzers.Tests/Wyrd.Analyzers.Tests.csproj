    <ProjectReference Include="..\..\src\Wyrd.Analyzers.CodeFixes\Wyrd.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\..\src\Wyrd\Wyrd.csproj" />
  </ItemGroup>

</Project>
